{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/soil/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/crop/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/history(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/profile(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/weather/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
