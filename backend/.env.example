# Database connection string (SQLite for dev, PostgreSQL for production)
# Example PostgreSQL: postgresql+psycopg://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./app.db

# Security
SECRET_KEY=generate-a-strong-random-secret-key-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment and Debug
APP_ENV=production
APP_DEBUG=false

# Allowed CORS origins (comma-separated or * for wildcard)
CORS_ORIGINS=*

# Twilio credentials for mobile OTP login (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_EXPIRE_MINUTES=5
